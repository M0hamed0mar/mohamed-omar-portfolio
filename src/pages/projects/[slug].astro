---
import { projects } from '@/data/projects';
import type { Project } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} - Mohamed Omar`}
  description={project.description}
  image={project.coverImage}
>
  <Navbar />

  <main class="pt-16 md:pt-18">
    <article class="container-custom">
      <div class="py-12 md:py-16">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 text-sm text-foreground-muted hover:text-accent transition-colors"
        >
          <svg
            class="h-3.5 w-3.5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5"></path>
            <path d="m12 19-7-7 7-7"></path>
          </svg>
          Back to projects
        </a>
      </div>

      <header class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3">
          <span class="badge-accent">
            {project.category}
          </span>
          <span class="font-mono text-xs text-foreground-subtle">
            {project.year}
          </span>
          {project.duration && (
            <>
              <span class="text-foreground-faint">-</span>
              <span class="font-mono text-xs text-foreground-subtle">
                {project.duration}
              </span>
            </>
          )}
        </div>

        <h1 class="mt-6 font-display text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl lg:text-6xl">
          {project.title}
        </h1>

        <p class="mt-4 text-lg text-foreground-muted md:text-xl">
          {project.subtitle}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            <svg
              class="h-4 w-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
            View on GitHub
          </a>

          <span class="inline-flex items-center gap-2 text-sm text-foreground-muted">
            <span class="font-mono text-xs uppercase tracking-widest text-foreground-faint">
              Role:
            </span>
            <span>{project.role}</span>
          </span>
        </div>
      </header>

      <div class="mt-16 overflow-hidden rounded-2xl border border-border bg-background-subtle">
        <img
          src={project.coverImage}
          alt={`${project.title} - Cover`}
          width="1600"
          height="1000"
          loading="eager"
          decoding="async"
          class="h-auto w-full object-cover"
        />
      </div>

      <section class="mt-20 grid gap-6 border-t border-border pt-12 sm:grid-cols-3">
        {
          project.metrics.map((metric) => (
            <div>
              <div class="font-display text-4xl font-semibold text-foreground md:text-5xl">
                {metric.value}
              </div>
              <div class="mt-2 text-xs uppercase tracking-wider text-foreground-subtle md:text-sm">
                {metric.label}
              </div>
            </div>
          ))
        }
      </section>

      <section class="mt-20 border-t border-border pt-12">
        <p class="section-label">Overview</p>
        <h2 class="mt-3 font-display text-2xl font-semibold text-foreground md:text-3xl">
          Project overview
        </h2>
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-foreground-muted md:text-lg">
          {project.longDescription}
        </p>
      </section>

      <section class="mt-20 border-t border-border pt-12">
        <p class="section-label">Architecture</p>
        <h2 class="mt-3 font-display text-2xl font-semibold text-foreground md:text-3xl">
          System architecture
        </h2>
        <p class="mt-4 max-w-3xl text-sm text-foreground-muted">
          A high-level view of the components, data flow, and deployment layers.
        </p>

        <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-background-subtle">
          <img
            src={project.architectureImage}
            alt={`${project.title} - Architecture Diagram`}
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </div>
      </section>

      {project.benchmarkImage && (
        <section class="mt-20 border-t border-border pt-12">
          <p class="section-label">Benchmark</p>
          <h2 class="mt-3 font-display text-2xl font-semibold text-foreground md:text-3xl">
            Measurable results
          </h2>
          <p class="mt-4 max-w-3xl text-sm text-foreground-muted">
            Results from a reproducible evaluation benchmark. Numbers reflect
            improvements over the baseline configuration.
          </p>

          <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-background-subtle">
            <img
              src={project.benchmarkImage}
              alt={`${project.title} - Benchmark Chart`}
              width="1200"
              height="600"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-cover"
            />
          </div>
        </section>
      )}

      <section class="mt-20 border-t border-border pt-12">
        <p class="section-label">Highlights</p>
        <h2 class="mt-3 font-display text-2xl font-semibold text-foreground md:text-3xl">
          Key implementation details
        </h2>

        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {
            project.highlights.map((highlight) => (
              <li class="flex items-start gap-3">
                <span class="mt-1.5 flex h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                <span class="text-sm leading-relaxed text-foreground-muted">
                  {highlight}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-20 border-t border-border pt-12">
        <p class="section-label">Tech Stack</p>
        <h2 class="mt-3 font-display text-2xl font-semibold text-foreground md:text-3xl">
          Technologies used
        </h2>

        <div class="mt-8 flex flex-wrap gap-2">
          {
            project.techStack.map((tech) => (
              <span class="badge text-xs">
                {tech}
              </span>
            ))
          }
        </div>
      </section>

      <section class="mt-20 mb-20 rounded-2xl border border-border bg-background-subtle p-8 md:p-12">
        <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
          <div>
            <h3 class="font-display text-xl font-semibold text-foreground md:text-2xl">
              Explore more work
            </h3>
            <p class="mt-2 text-sm text-foreground-muted">
              Browse the full list of projects or reach out to discuss this one.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/projects" class="btn-secondary">
              All projects
            </a>
            <a href="/#contact" class="btn-primary">
              Get in touch
            </a>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>
