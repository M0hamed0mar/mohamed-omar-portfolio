---
import { skillCategories } from '@/data/skills';
import SkillIcon from '@/components/ui/SkillIcon.astro';

const sizeClasses: Record<string, string> = {
  large: 'md:col-span-2 md:row-span-1',
  medium: 'md:col-span-1 md:row-span-1',
  small: 'md:col-span-1 md:row-span-1',
};
---

<section id="skills" class="section border-t border-border">
  <div class="container-custom">
    <div class="max-w-3xl">
      <p class="section-label">Toolkit</p>
      <h2 class="section-title">
        Skills and
        <span class="text-gradient-violet">Technologies</span>
      </h2>
      <p class="section-description">
        A curated stack of tools, frameworks, and platforms used to ship
        production-grade AI systems end-to-end.
      </p>
    </div>

    <div class="mt-16 grid gap-4 md:grid-cols-3">
      {
        skillCategories.map((category) => (
          <div
            class:list={[
              'group relative overflow-hidden rounded-2xl border border-border bg-background-subtle p-6 transition-all duration-300 hover:border-border-strong hover:bg-background-muted',
              sizeClasses[category.size],
            ]}
          >
            <div class="flex items-start justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent/10 text-accent transition-all duration-300 group-hover:bg-accent/20 group-hover:scale-105">
                <SkillIcon name={category.icon} class="h-5 w-5" />
              </div>
              <span class="font-mono text-2xs uppercase tracking-widest text-foreground-faint">
                {String(category.skills.length).padStart(2, '0')}
              </span>
            </div>

            <h3 class="mt-6 text-lg font-semibold text-foreground">
              {category.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-foreground-muted">
              {category.description}
            </p>

            <div class="mt-6 flex flex-wrap gap-1.5">
              {category.skills.map((skill) => (
                <span class="badge text-2xs">
                  {skill}
                </span>
              ))}
            </div>

            <div
              class="pointer-events-none absolute -bottom-20 -right-20 h-40 w-40 rounded-full bg-accent/5 blur-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"
              aria-hidden="true"
            >
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
