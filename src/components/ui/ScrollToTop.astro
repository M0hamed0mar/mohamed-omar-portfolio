---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  id="scroll-to-top"
  type="button"
  aria-label="Scroll to top"
  class:list={[
    'fixed bottom-6 right-6 z-40 inline-flex h-11 w-11 items-center justify-center rounded-full',
    'border border-border bg-background-elevated/90 text-foreground-muted backdrop-blur-md',
    'shadow-soft-dark transition-all duration-300',
    'hover:border-accent/50 hover:text-accent',
    'opacity-0 translate-y-4 pointer-events-none',
    className,
  ]}
>
  <svg
    class="h-4 w-4"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m18 15-6-6-6 6"></path>
  </svg>
</button>

<script>
  const scrollBtn = document.getElementById('scroll-to-top');
  const SHOW_THRESHOLD = 400;

  function toggleButton() {
    if (!scrollBtn) return;
    if (window.scrollY > SHOW_THRESHOLD) {
      scrollBtn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    } else {
      scrollBtn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    }
  }

  toggleButton();
  window.addEventListener('scroll', toggleButton, { passive: true });

  scrollBtn?.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
